# =============================================================
# AI Provider (выберите один)
# =============================================================
# yandex | selectel | selectel_router
AI_PROVIDER=yandex

# --- Yandex AI Studio ---
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_API_KEY=your_yandex_api_key_here
# Опционально: кастомный API endpoint (обычно не нужен)
# YANDEX_API_BASE=https://llm.api.cloud.yandex.net

# --- Selectel AI Gateway ---
# SELECTEL_API_KEY=your_selectel_api_key_here
# SELECTEL_ROUTER_MODEL=moonshotai/kimi-k2.6
# SELECTEL_ROUTER_REASONING=low

# =============================================================
# Retry Logic
# =============================================================
ENABLE_RETRY=true
RETRY_MAX_ATTEMPTS=3
RETRY_TIMEOUT_SECONDS=60
RETRY_BACKOFF_FACTOR=2.0

# =============================================================
# Telemetry (OpenTelemetry)
# =============================================================
# OTLP endpoint для отправки телеметрии
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=agent-harness
# OTEL_RESOURCE_ATTRIBUTES=env=production,team=ai

# =============================================================
# Cost Tracking
# =============================================================
# Лимит расходов в рублях. При достижении — бросает CostLimitExceeded
# и останавливает харнесс. Оставить пустым для безлимитного режима.
HARNESS_COST_LIMIT=100.0

# Кастомный прайс в формате JSON (приоритет выше DEFAULT_PRICING).
# Пример: {"gemini-2.5-flash": {"input": 0.15, "cached": 0.075, "output": 0.6}}
# HARNESS_MODEL_PRICING={"gemini-2.5-flash": {"input": 0.15, "cached": 0.075, "output": 0.6}}
